OLLAMA_URL=http://ollama:11434

# Claude Code — gere com: claude setup-token (requer subscrição Claude)
CLAUDE_CODE_OAUTH_TOKEN=...

# GitHub — crie um Personal Access Token com: repo, issues, pull_requests
GITHUB_TOKEN=ghp_...

# --- Projeto único (mais simples) ---
GITHUB_OWNER=seu-usuario-ou-org
GITHUB_REPO=nome-do-repositorio
REPO_LOCAL_PATH=/workspace/repo
BASE_BRANCH=dev

# --- Múltiplos projetos (substitui as 4 vars acima quando definido) ---
# Cada entry precisa de: owner, repo, localPath, baseBranch
# githubToken é opcional — herda GITHUB_TOKEN se omitido
#
# PROJECTS='[
#   {"owner":"org","repo":"repo1","localPath":"/workspace/repo1","baseBranch":"dev"},
#   {"owner":"org","repo":"repo2","localPath":"/workspace/repo2","baseBranch":"main"},
#   {"owner":"org","repo":"repo3","localPath":"/workspace/repo3","baseBranch":"dev","githubToken":"ghp_outro_token"}
# ]'

# Scheduler
POLL_INTERVAL_MINUTES=5
MAX_ISSUES_PER_RUN=3

# Agent limits
MAX_TOKENS_PER_SESSION=50000
AGENT_TIMEOUT_MS=300000

# ChromaDB (sobe junto no docker-compose)
CHROMA_URL=http://chromadb:8000

# Modelo de embedding (Anthropic Voyage)
EMBEDDING_MODEL=nomic-embed-text
